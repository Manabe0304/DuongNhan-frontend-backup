@page "/profile/change-password"

<div class="container dn-container dn-page">
    <div class="dn-page-heading">
        <span class="dn-kicker">Bảo mật</span>
        <h1>Đổi mật khẩu</h1>
    </div>

    <div class="dn-card p-4 p-lg-5" style="max-width: 520px;">
        @if (saved)
        {
            <div class="alert alert-success small">Đổi mật khẩu thành công!</div>
        }

        <form @onsubmit="Submit" @onsubmit:preventDefault>
            <div class="mb-3">
                <label class="form-label">Mật khẩu hiện tại</label>
                <input class="form-control" type="password" @bind="currentPassword" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu mới</label>
                <input class="form-control" type="password" @bind="newPassword" required />
            </div>
            <button class="btn btn-dn-coral w-100">Cập nhật mật khẩu</button>
        </form>
    </div>
</div>

@code {
    private string currentPassword = "";
    private string newPassword = "";
    private bool saved;

    private async Task Submit()
    {
        saved = true;
        await Task.CompletedTask;
    }
}
