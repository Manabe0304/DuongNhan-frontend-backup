<div class="dn-card p-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="small fw-semibold text-secondary">Số lượt quét AI đã dùng</span>
        <span class="small fw-bold text-dark">@Used / @Total</span>
    </div>
    <div class="progress" style="height: 8px;">
        <div class="progress-bar @ProgressBarClass" role="progressbar" style="width: @Percentage%"></div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-2 small text-secondary">
        <span>Còn lại: @(Math.Max(0, Total - Used)) lượt</span>
        <a href="/pricing" class="text-danger text-decoration-none fw-semibold">Nâng cấp</a>
    </div>
</div>

@code {
    [Parameter] public int Used { get; set; } = 0;
    [Parameter] public int Total { get; set; } = 5;

    private int Percentage => Total > 0 ? Math.Min(100, (int)Math.Round((double)Used / Total * 100)) : 0;

    private string ProgressBarClass => Percentage switch
    {
        >= 90 => "bg-danger",
        >= 70 => "bg-warning",
        _ => "bg-success"
    };
}
