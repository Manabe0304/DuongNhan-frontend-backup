<div class="dn-card p-3 d-flex align-items-center justify-content-between mb-2">
    <div class="d-flex align-items-center gap-3">
        <img src="@(string.IsNullOrWhiteSpace(ImageUrl) ? "https://images.unsplash.com/photo-1556228720-195a672e8a03?w=100" : ImageUrl)" 
             alt="Skin capture" class="rounded-3" style="width: 52px; height: 52px; object-fit: cover;" />
        <div>
            <h6 class="mb-0">@PrimaryCondition</h6>
            <span class="small text-secondary">@Date.ToString("dd/MM/yyyy HH:mm") • Điểm da: <strong class="text-success">@HealthScore/100</strong></span>
        </div>
    </div>
    <a href="/diagnosis/@DiagnosisId" class="btn btn-outline-secondary btn-sm">Xem chi tiết</a>
</div>

@code {
    [Parameter] public Guid DiagnosisId { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string PrimaryCondition { get; set; } = "Phân tích da";
    [Parameter] public int HealthScore { get; set; } = 85;
    [Parameter] public DateTime Date { get; set; } = DateTime.Now;
}
