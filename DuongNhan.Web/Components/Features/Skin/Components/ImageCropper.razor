<div class="dn-image-cropper text-center">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img src="@ImageUrl" alt="Crop target" class="img-fluid rounded-3" style="max-height: 380px; object-fit: contain;" />
    }
</div>

@code {
    [Parameter] public string ImageUrl { get; set; } = "";
}
