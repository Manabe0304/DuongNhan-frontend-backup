@page "/diagnosis/{Id:guid}"
@inject DuongNhanApiService Api

<div class="container dn-container dn-page">
    <div class="dn-page-heading">
        <span class="dn-kicker">AI Result & Treatment Plan</span>
        <h1>Kết quả phân tích làn da</h1>
        <p>Phân tích chi tiết tình trạng da từ mô hình AI cùng phác đồ điều trị và chăm sóc từng bước được cá nhân hoá.</p>
    </div>

    @if (loading)
    {
        <div class="dn-card p-5 text-center">
            <div class="spinner-border text-danger"></div>
            <p class="small text-secondary mt-3">Đang phân tích cấu trúc da và lập phác đồ điều trị...</p>
        </div>
    }
    else if (diagnosis is null)
    {
        <div class="alert alert-warning">
            Không tìm thấy kết quả phân tích. <a href="/scan" class="fw-bold text-dark">Phân tích ảnh mới</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <!-- Main Diagnosis Card -->
                <div class="dn-card p-4 p-lg-5 mb-4">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <span class="badge rounded-pill text-bg-danger px-3 py-1">Mức độ: @Text("severity", "Moderate")</span>
                            <h2 class="mt-3 mb-1">@Text("primaryCondition", "Mụn & Viêm da nhẹ")</h2>
                            <p class="text-secondary small mb-0">@Text("summary", "AI phát hiện dấu hiệu bã nhờn tích tụ, lỗ chân lông to và các nốt mụn viêm nhẹ rải rác.")</p>
                        </div>
                        <div class="dn-confidence text-center p-3 rounded-4 bg-light">
                            <strong class="fs-2 text-danger d-block">@Percent("confidence")%</strong>
                            <small class="text-secondary">Độ tin cậy AI</small>
                        </div>
                    </div>
                    <hr class="my-4" />
                    <h6 class="fw-bold mb-3">Chỉ số da chi tiết</h6>
                    <div class="row g-3">
                        <div class="col-md-3 col-6">
                            <div class="mini-stat p-3 bg-light rounded-3">
                                <small class="text-secondary d-block">Tình trạng chính</small>
                                <strong class="text-dark">@Text("primaryCondition", "Da dầu mụn")</strong>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="mini-stat p-3 bg-light rounded-3">
                                <small class="text-secondary d-block">Loại da</small>
                                <strong class="text-dark">@Text("skinType", "Da hỗn hợp thiên dầu")</strong>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="mini-stat p-3 bg-light rounded-3">
                                <small class="text-secondary d-block">Điểm sức khỏe da</small>
                                <strong class="text-success">@Percent("skinHealthScore", 82)/100</strong>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="mini-stat p-3 bg-light rounded-3">
                                <small class="text-secondary d-block">Mức độ cảnh báo</small>
                                <strong class="text-warning">@Text("severity", "Trung bình")</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step-by-Step Treatment Plan (Phác đồ điều trị từng bước) -->
                <div class="dn-card p-4 p-lg-5">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div>
                            <span class="dn-kicker">Personalized Routine</span>
                            <h3 class="mb-0">Phác đồ điều trị 5 bước</h3>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">Khoa học & Cá nhân hóa</span>
                    </div>

                    <!-- Morning Routine -->
                    <div class="mb-4">
                        <h6 class="text-primary fw-bold mb-3 d-flex align-items-center gap-2">
                            <span>☀️</span> Liệu trình buổi sáng (Morning Routine)
                        </h6>
                        <div class="d-flex flex-column gap-3">
                            <div class="d-flex gap-3 p-3 bg-light rounded-3">
                                <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 26px; height: 26px; min-width: 26px;">1</span>
                                <div>
                                    <strong class="d-block text-dark">Bước 1: Làm sạch dịu nhẹ (Gentle Cleanser)</strong>
                                    <p class="small text-secondary mb-0">Rửa mặt bằng sữa rửa mặt pH 5.5 giúp loại bỏ dầu thừa ban đêm mà không làm tổn hại hàng rào ẩm tự nhiên.</p>
                                </div>
                            </div>
                            <div class="d-flex gap-3 p-3 bg-light rounded-3">
                                <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 26px; height: 26px; min-width: 26px;">2</span>
                                <div>
                                    <strong class="d-block text-dark">Bước 2: Cân bằng & Kháng viêm (Antioxidant / Niacinamide Serum)</strong>
                                    <p class="small text-secondary mb-0">Thoa serum Niacinamide 10% + Kẽm giúp điều tiết dầu nhờn, làm dịu ổ viêm và se khít lỗ chân lông.</p>
                                </div>
                            </div>
                            <div class="d-flex gap-3 p-3 bg-light rounded-3">
                                <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 26px; height: 26px; min-width: 26px;">3</span>
                                <div>
                                    <strong class="d-block text-dark">Bước 3: Bảo vệ tối ưu (Broad-Spectrum Sunscreen)</strong>
                                    <p class="small text-secondary mb-0">Thoa kem chống nắng quang phổ rộng SPF 50+ PA++++ không nhờn rít trước khi ra ngoài 20 phút để ngăn ngừa thâm mụn.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Evening Routine -->
                    <div>
                        <h6 class="text-dark fw-bold mb-3 d-flex align-items-center gap-2">
                            <span>🌙</span> Liệu trình buổi tối (Evening Routine)
                        </h6>
                        <div class="d-flex flex-column gap-3">
                            <div class="d-flex gap-3 p-3 bg-light rounded-3">
                                <span class="badge bg-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 26px; height: 26px; min-width: 26px;">4</span>
                                <div>
                                    <strong class="d-block text-dark">Bước 4: Làm sạch sâu kép (Double Cleansing)</strong>
                                    <p class="small text-secondary mb-0">Tẩy trang dạng Micellar Water hoặc dầu nhũ hoá, sau đó rửa lại với sữa rửa mặt để giải phóng bụi mịn sâu dưới lỗ chân lông.</p>
                                </div>
                            </div>
                            <div class="d-flex gap-3 p-3 bg-light rounded-3">
                                <span class="badge bg-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 26px; height: 26px; min-width: 26px;">5</span>
                                <div>
                                    <strong class="d-block text-dark">Bước 5: Đặc trị & Phục hồi hàng rào ẩm (Treatment & Moisturizer)</strong>
                                    <p class="small text-secondary mb-0">Dùng BHA 2% (2-3 lần/tuần) hoặc chấm mụn salicylic acid, sau đó khóa ẩm bằng kem dưỡng chứa Ceramide & Hyaluronic Acid.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Side recommendations -->
            <div class="col-lg-4">
                <div class="dn-card p-4 mb-4">
                    <h5>Gợi ý sản phẩm phù hợp</h5>
                    <p class="small text-secondary">Các sản phẩm được thuật toán AI đối soát thành phần tương thích với làn da của bạn.</p>
                    <a class="btn btn-dn-coral w-100 mb-2" href="/recommendations">Khám phá sản phẩm khuyên dùng</a>
                    <a class="btn btn-dn-outline w-100" href="/doctors">Đặt lịch khám chuyên sâu</a>
                </div>

                <div class="dn-card p-4 bg-light">
                    <span class="dn-kicker">Lưu ý chuyên môn</span>
                    <h6 class="mt-2">Khuyến nghị từ Bác sĩ</h6>
                    <p class="small text-secondary mb-0">
                        Phác đồ trên được thiết kế để điều chỉnh tình trạng da trong 4 - 6 tuần. Trong trường hợp có phản ứng mẩn đỏ kéo dài hoặc mụn bọc sưng viêm nhiều, hãy ngưng sản phẩm tẩy da chết và tham vấn bác sĩ da liễu.
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }
    private System.Text.Json.JsonElement? diagnosis;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        diagnosis = await Api.DiagnoseAsync(Id);
        loading = false;
    }

    private string Text(string name, string fallback)
    {
        if (diagnosis is not { ValueKind: System.Text.Json.JsonValueKind.Object } d) return fallback;
        foreach (var key in new[] { name, char.ToUpperInvariant(name[0]) + name[1..] })
            if (d.TryGetProperty(key, out var p))
                return p.ValueKind == System.Text.Json.JsonValueKind.String ? p.GetString() ?? fallback : p.ToString();
        return fallback;
    }

    private int Percent(string name, int fallback = 0)
    {
        var raw = Text(name, fallback.ToString());
        return double.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n)
            ? (int)Math.Round(n <= 1 ? n * 100 : n) : fallback;
    }
}
