<div class="dn-password-meter mt-2">
    <div class="progress" style="height: 4px;">
        <div class="progress-bar @MeterColor" style="width: @(Score * 25)%"></div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-1">
        <small class="text-secondary">Độ mạnh mật khẩu</small>
        <small class="@TextColor fw-semibold">@Label</small>
    </div>
</div>

@code {
    [Parameter] public string Password { get; set; } = "";

    private int Score
    {
        get
        {
            if (string.IsNullOrEmpty(Password)) return 0;
            int s = 1;
            if (Password.Length >= 8) s++;
            if (Password.Any(char.IsUpper) && Password.Any(char.IsLower)) s++;
            if (Password.Any(char.IsDigit) || Password.Any(ch => !char.IsLetterOrDigit(ch))) s++;
            return s;
        }
    }

    private string Label => Score switch
    {
        <= 1 => "Yếu",
        2 => "Trung bình",
        3 => "Khá",
        _ => "Mạnh"
    };

    private string MeterColor => Score switch
    {
        <= 1 => "bg-danger",
        2 => "bg-warning",
        3 => "bg-info",
        _ => "bg-success"
    };

    private string TextColor => Score switch
    {
        <= 1 => "text-danger",
        2 => "text-warning",
        3 => "text-info",
        _ => "text-success"
    };
}
