@page "/reset-password"
@page "/auth/reset-password"
@inject NavigationService Navigation

<div class="container dn-container dn-page py-5">
    <div class="dn-card p-5 mx-auto" style="max-width: 480px;">
        <h3>Đặt lại mật khẩu</h3>
        <p class="small text-secondary mb-4">Vui lòng nhập mật khẩu mới cho tài khoản của bạn.</p>
        <form @onsubmit="Submit" @onsubmit:preventDefault>
            <div class="mb-3">
                <label class="form-label">Mật khẩu mới</label>
                <input class="form-control" type="password" @bind="newPassword" required placeholder="••••••••" />
            </div>
            <div class="mb-3">
                <label class="form-label">Xác nhận mật khẩu mới</label>
                <input class="form-control" type="password" @bind="confirmPassword" required placeholder="••••••••" />
            </div>
            <button class="btn btn-dn-coral w-100">Lưu mật khẩu mới</button>
        </form>
    </div>
</div>

@code {
    private string newPassword = "";
    private string confirmPassword = "";

    private void Submit()
    {
        Navigation.NavigateTo("/login");
    }
}
