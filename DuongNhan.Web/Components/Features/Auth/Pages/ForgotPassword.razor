@page "/forgot-password"
@page "/auth/forgot-password"
@inject NavigationService Navigation

<div class="dn-auth-page">
    <div class="dn-auth-brand d-none d-lg-flex">
        <div class="dn-auth-brand-inner">
            <a href="/" class="dn-brand dn-brand-light"><span class="dn-brand-mark">✚</span>Dưỡng Nhan</a>
            <div class="mt-auto">
                <h2>Khôi phục quyền truy cập vào tài khoản Dưỡng Nhan của bạn.</h2>
            </div>
            <small class="text-secondary">© 2026 Dưỡng Nhan AI Platform</small>
        </div>
    </div>

    <div class="dn-auth-form-wrap">
        <div class="dn-auth-form">
            <a href="/login" class="small text-secondary text-decoration-none">← Quay lại đăng nhập</a>
            <span class="dn-kicker mt-4">Khôi phục</span>
            <h1>Quên mật khẩu?</h1>
            <p class="text-secondary small">Nhập địa chỉ email đăng ký để nhận liên kết đặt lại mật khẩu.</p>

            @if (sent)
            {
                <div class="alert alert-success small">
                    Chúng tôi đã gửi hướng dẫn đặt lại mật khẩu tới <strong>@email</strong>. Vui lòng kiểm tra hộp thư.
                </div>
            }
            else
            {
                <form @onsubmit="Submit" @onsubmit:preventDefault>
                    <div class="mb-3">
                        <label>Địa chỉ Email</label>
                        <input class="form-control form-control-lg" type="email" @bind="email" required placeholder="name@example.com" />
                    </div>
                    <button class="btn btn-dn-coral btn-lg w-100" disabled="@loading">
                        @(loading ? "Đang gửi..." : "Gửi liên kết khôi phục")
                    </button>
                </form>
            }

            <div class="text-center small text-secondary mt-4">
                Đã nhớ mật khẩu? <a href="/login" class="fw-semibold text-dark">Đăng nhập ngay</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private bool loading;
    private bool sent;

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(email)) return;
        loading = true;
        await Task.Delay(600);
        sent = true;
        loading = false;
    }
}
